PORT=5000
MONGODB_URI=mongodb://localhost:27017/smartcare
JWT_SECRET=smartcare_jwt_super_secret_key_2026_secure
JWT_REFRESH_SECRET=smartcare_jwt_refresh_secret_key_2026_secure
GEMINI_API_KEY=your_gemini_api_key_here
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# --- EMAIL CONFIGURATION ---
# Option 1 (Best for Render Free Tier): Brevo HTTPS REST API (Free 300 emails/day, port 443, never blocked)
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option 2 (Alternative for Cloud): Resend HTTPS REST API (Free 100 emails/day, port 443, never blocked)
# RESEND_API_KEY=re_your_resend_api_key_here

# Option 3 (For Local Development): Gmail SMTP with App Password
SMTP_SERVICE=gmail
SMTP_USER=healthmscare@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM="HealthMS" <healthmscare@gmail.com>

# --- MOBILE NOTIFICATION CONFIGURATION (Twilio WhatsApp & SMS) ---
# Sign up at https://www.twilio.com (Free $15.50 trial credits)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Set to 'true' to use Twilio WhatsApp Sandbox (100% Free, no phone number rental needed)
TWILIO_WHATSAPP_ENABLED=true
# Default Twilio WhatsApp sandbox number (leave as is unless using custom WhatsApp sender)
TWILIO_WHATSAPP_NUMBER=+14155238886
# (Optional: Dedicated Twilio phone number for cellular SMS if available)
# TWILIO_PHONE_NUMBER=+1234567890
